#!/bin/sh
# lumen — small control CLI.
#   lumen theme                     rebuild tokens + reload everything
#   lumen theme <dark|midnight|oled|light>
#   lumen accent <ion|ember|iris|jade|wallpaper>
#   lumen transparency [on|off|toggle]   window transparency (shell glass stays)
#   lumen accent-hue <0-360>         set the wallpaper-derived accent hue (used by the picker)
#   lumen clock <12h|24h>  ·  lumen motion <full|reduced>  ·  lumen reload
#   lumen set <gaps|corners|border|anim_speed|follow_mouse|cursor|cursor_size|idle_lock|idle_sleep|
#              accent_style|accent_intensity|glass_level|motion_scale|pointer_speed|accel|natural_scroll|
#              tap_click|scroll_speed|dwt|left_handed|kb_repeat_delay|kb_repeat_rate|kb_layout> <value>
#   lumen check                     contrast report for the active theme
#   lumen bench [--json] [--cpu N]  what the running shell costs: memory, CPU, startup
#   lumen rebuild                   regenerate app themes (Qt/KDE, kitty…) without reloading
#   lumen progress <title> <0-100|-1|done|fail> [detail]   show progress in the island
#   lumen run [--title T] -- <command…>   run it; the island shows it working, then ✓ or ✗
#   lumen snapshot save|restore|list|delete [name]   a whole setup of windows, saved and restored
#   lumen update [check|apply]       Lumen itself: what changed on GitHub · fast-forward to it (then lumen reload)
#   lumen recovery [command]        Lumen Recovery: a menu that works from a TTY (safe mode, restore settings…)
#   lumen backup [now|status|…]     back up your files to a drive or folder (scripts/backup.sh)
set -eu
LUMEN_ROOT=${LUMEN_ROOT:-$HOME/.config/lumen}
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/lumen/state.json

# State edits are serialised: several Lumen processes (shells, the settings
# app) may write at the same moment. flock + a unique temp file + atomic mv
# means a write can never clobber or truncate another.
edit_state() {   # edit_state <jq args…> <filter>
    mkdir -p "$(dirname "$STATE")"
    (
        flock -w 5 9 || { echo "lumen: state is busy" >&2; exit 1; }
        [ -s "$STATE" ] && jq -e type "$STATE" >/dev/null 2>&1 || echo '{}' > "$STATE"
        tmp=$(mktemp "$STATE.XXXXXX") || exit 1
        if jq "$@" "$STATE" > "$tmp"; then mv "$tmp" "$STATE"; else rm -f "$tmp"; exit 1; fi
    ) 9>"$STATE.lock"
}
set_state() {   # set_state <key> <value>
    # shellcheck disable=SC2016  # $k/$v are jq variables
    edit_state --arg k "$1" --arg v "$2" '.[$k] = $v'
}

reload() {
    python3 "$LUMEN_ROOT/theme/build.py"
    hyprctl reload >/dev/null 2>&1 || true
    # Running kitties re-read their config (colours, opacity) on SIGUSR1;
    # the shell watches generated/tokens.json by itself.
    pkill -USR1 -u "$(id -u)" -x kitty 2>/dev/null || true
}

# Restart hypridle with the regenerated config — only the one Lumen started in
# THIS Hyprland session (other sessions, e.g. illogical-impulse, run their own).
restart_idle() {
    [ -n "${LUMEN_NESTED:-}" ] && return 0      # nested test instances have no hypridle
    sig=${HYPRLAND_INSTANCE_SIGNATURE:-}
    [ -n "$sig" ] || return 0
    for pid in $(pgrep -u "$(id -u)" -x hypridle); do
        tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | grep -Eq "^$LUMEN_ROOT/(generated/)?hypr/hypridle.conf\$" || continue
        tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -qx "HYPRLAND_INSTANCE_SIGNATURE=$sig" || continue
        kill "$pid" 2>/dev/null || true
    done
    setsid -f hypridle -c "$LUMEN_ROOT/generated/hypr/hypridle.conf" >/dev/null 2>&1 </dev/null
}

case ${1:-} in
    theme)
        if [ -n "${2:-}" ]; then
            [ -f "$LUMEN_ROOT/theme/themes/$2.toml" ] || { echo "lumen: no theme '$2'" >&2; exit 1; }
            set_state theme "$2"
        fi
        reload ;;
    accent)
        [ -n "${2:-}" ] || { echo "usage: lumen accent <name>" >&2; exit 2; }
        set_state accent "$2"; reload ;;
    transparency)
        cur=$(jq -r '.transparency // "on"' "$STATE" 2>/dev/null || echo on)
        case ${2:-toggle} in
            on|off) new=$2 ;;
            toggle) [ "$cur" = off ] && new=on || new=off ;;
            *) echo "usage: lumen transparency [on|off|toggle]" >&2; exit 2 ;;
        esac
        set_state transparency "$new"
        reload
        if [ "$new" = on ]; then icon=blur_on; msg="Transparency on"; else icon=blur_off; msg="Transparency off"; fi
        "$LUMEN_ROOT/bin/lumen-shell-ipc" island event "$icon" "$msg" "Super+Shift+G to switch" >/dev/null 2>&1 || true ;;
    accent-hue)
        case ${2:-} in ''|*[!0-9.]*) echo "usage: lumen accent-hue <0-360>" >&2; exit 2 ;; esac
        # shellcheck disable=SC2016  # $h is a jq variable
        edit_state --argjson h "$2" '.wallpaper_hue = $h'
        [ "$(jq -r '.accent // ""' "$STATE")" = wallpaper ] && reload || true ;;
    clock)
        case ${2:-} in 12h|24h) set_state clock "$2"; reload ;; *) echo "usage: lumen clock 12h|24h" >&2; exit 2 ;; esac ;;
    motion)
        case ${2:-} in full) set_state reduced_motion off; reload ;; reduced) set_state reduced_motion on; reload ;;
                       *) echo "usage: lumen motion full|reduced" >&2; exit 2 ;; esac ;;
    set)
        # Whitelisted window/motion preferences (Lumen Settings → Windows)
        case "${2:-}=${3:-}" in
            gaps=compact|gaps=normal|gaps=roomy|corners=square|corners=soft|corners=round|\
            border=off|border=thin|border=normal|anim_speed=fast|anim_speed=normal|anim_speed=relaxed|\
            follow_mouse=on|follow_mouse=off)
                set_state "$2" "$3"; reload ;;
            cursor=Bibata-Modern-Classic|cursor=Bibata-Modern-Ice|cursor=Bibata-Modern-Amber|cursor=breeze_cursors|\
            cursor_size=24|cursor_size=28|cursor_size=32)
                set_state "$2" "$3"; reload
                cur=$(jq -r .cursor.theme "$LUMEN_ROOT/generated/tokens.json")
                size=$(jq -r .cursor.size "$LUMEN_ROOT/generated/tokens.json")
                hyprctl setcursor "$cur" "$size" >/dev/null 2>&1 || true
                # GTK apps read it from gsettings
                gsettings set org.gnome.desktop.interface cursor-theme "$cur" 2>/dev/null || true
                gsettings set org.gnome.desktop.interface cursor-size "$size" 2>/dev/null || true ;;
            accent_style=adaptive|accent_style=exact|accent_style=subtle|accent_style=mono)
                set_state "$2" "$3"; reload ;;
            # Mouse, touchpad and keyboard (Settings → Mouse & touchpad / Keyboard)
            accel=adaptive|accel=flat|natural_scroll=on|natural_scroll=off|tap_click=on|tap_click=off|\
            dwt=on|dwt=off|left_handed=on|left_handed=off)
                set_state "$2" "$3"; reload ;;
            pointer_speed=*)
                printf '%s' "$3" | grep -Eqx -- '-?[0-9]{1,3}' && [ "$3" -ge -100 ] && [ "$3" -le 100 ] \
                    || { echo "lumen: pointer_speed is -100…100" >&2; exit 2; }
                set_state "$2" "$3"; reload ;;
            scroll_speed=*|kb_repeat_delay=*|kb_repeat_rate=*)
                case $3 in ''|*[!0-9]*) echo "lumen: $2 takes a whole number" >&2; exit 2 ;; esac
                case $2 in
                    scroll_speed)    [ "$3" -ge 25 ]  && [ "$3" -le 200 ] ;;
                    kb_repeat_delay) [ "$3" -ge 150 ] && [ "$3" -le 800 ] ;;
                    kb_repeat_rate)  [ "$3" -ge 10 ]  && [ "$3" -le 80 ] ;;
                esac || { echo "lumen: $2 out of range" >&2; exit 2; }
                set_state "$2" "$3"; reload ;;
            kb_layout=*)
                printf '%s' "$3" | grep -Eqx '[a-z]{2,3}(\([a-z_]+\))?(,[a-z]{2,3}(\([a-z_]+\))?){0,3}' \
                    || { echo "lumen: kb_layout looks like us or us,in or de(nodeadkeys)" >&2; exit 2; }
                set_state "$2" "$3"; reload ;;
            accent_intensity=*|glass_level=*|motion_scale=*)
                # numbers only, within range (build.py clamps too)
                case $3 in ''|*[!0-9]*) echo "lumen: $2 takes a whole number" >&2; exit 2 ;; esac
                case $2 in
                    accent_intensity) [ "$3" -ge 50 ] && [ "$3" -le 130 ] ;;
                    glass_level)      [ "$3" -ge 0 ]  && [ "$3" -le 100 ] ;;
                    motion_scale)     [ "$3" -ge 50 ] && [ "$3" -le 200 ] ;;
                esac || { echo "lumen: $2 out of range" >&2; exit 2; }
                set_state "$2" "$3"; reload ;;
            idle_lock=2|idle_lock=5|idle_lock=10|idle_lock=15|idle_lock=30|idle_lock=never|\
            idle_sleep=15|idle_sleep=30|idle_sleep=60|idle_sleep=battery|idle_sleep=never)
                set_state "$2" "$3"; python3 "$LUMEN_ROOT/theme/build.py" >/dev/null; restart_idle ;;
            *) echo "lumen: unknown setting '${2:-}=${3:-}'" >&2; exit 2 ;;
        esac ;;
    reload)
        hyprctl reload >/dev/null 2>&1 || true
        "$LUMEN_ROOT/bin/lumen-shell-ipc" shell reload ;;
    check)
        python3 "$LUMEN_ROOT/theme/build.py" --check ;;
    bench)
        shift; exec "$LUMEN_ROOT/scripts/bench.sh" "$@" ;;
    rebuild)    # regenerate app themes (e.g. after the icon theme changed); new windows pick it up
        python3 "$LUMEN_ROOT/theme/build.py" >/dev/null ;;
    progress)
        # lumen progress "Building Lumen" 72     ·  lumen progress "Building Lumen" done
        title=${2:?usage: lumen progress <title> <0-100|-1|done|fail> [detail]}; v=${3:?}; detail=${4:-}
        id=$(printf '%s' "$title" | cksum | cut -d' ' -f1)
        case $v in
            done) exec "$LUMEN_ROOT/bin/lumen-shell-ipc" island progressDone "$id" "$title" true "$detail" ;;
            fail) exec "$LUMEN_ROOT/bin/lumen-shell-ipc" island progressDone "$id" "$title" false "$detail" ;;
            -1|[0-9]|[0-9][0-9]|100) exec "$LUMEN_ROOT/bin/lumen-shell-ipc" island progress "$id" "$title" "$v" "$detail" ;;
            *) echo "lumen progress: value must be 0-100, -1, done or fail" >&2; exit 2 ;;
        esac ;;
    snapshot)
        shift; exec "$LUMEN_ROOT/scripts/snapshot.sh" "$@" ;;
    update)
        case ${2:-check} in
            check) "$LUMEN_ROOT/scripts/lumen-self-update.sh" check | jq -r '
                if .error then .error
                elif .behind == 0 then "Lumen is up to date (\(.current) on \(.branch))"
                else "\(.behind) new change(s) on \(.remote):\n" + ([.changes[] | "  \(.sha)  \(.subject)"] | join("\n"))
                     + (if .dirty then "\nYou have uncommitted changes: commit or stash them before updating." else "" end)
                     + (if .diverged then "\nYour copy has its own commits too: update by hand with git." else "" end)
                end' ;;
            apply) "$LUMEN_ROOT/scripts/lumen-self-update.sh" apply | tail -n 1 | jq -r '
                if .error then .error
                elif .state == "updated" then "Updated \(.from) → \(.current). Run: lumen reload"
                else "Lumen is up to date (\(.current))" end' ;;
            *) echo "usage: lumen update [check|apply]" >&2; exit 2 ;;
        esac ;;
    recovery)
        shift; exec "$LUMEN_ROOT/scripts/recovery.sh" "$@" ;;
    backup)
        shift
        if [ "${1:-now}" = now ]; then [ $# -gt 0 ] && shift; set -- run "$@"; fi
        exec "$LUMEN_ROOT/scripts/backup.sh" "$@" ;;
    run)
        # lumen run -- make -j8   ·   lumen run --title "Building" -- cargo build
        shift; title=""
        [ "${1:-}" = --title ] && { title=$2; shift 2; }
        [ "${1:-}" = -- ] && shift
        [ $# -gt 0 ] || { echo "usage: lumen run [--title T] -- <command…>" >&2; exit 2; }
        [ -n "$title" ] || title="Running $1"
        ipc="$LUMEN_ROOT/bin/lumen-shell-ipc"; id=$(printf '%s%s' "$title" "$$" | cksum | cut -d' ' -f1)
        start=$(date +%s)
        # keep the island's bar alive while it runs (it lingers 6 s per update)
        ( while :; do "$ipc" island progress "$id" "$title" -1 "" >/dev/null 2>&1; sleep 4; done ) & beat=$!
        "$@" && rc=0 || rc=$?
        kill "$beat" 2>/dev/null; wait "$beat" 2>/dev/null || true
        secs=$(( $(date +%s) - start )); took=$( [ $secs -ge 60 ] && echo "$((secs / 60))m $((secs % 60))s" || echo "${secs}s" )
        if [ $rc -eq 0 ]; then "$ipc" island progressDone "$id" "${title#Running } finished" true "$took" >/dev/null 2>&1
        else "$ipc" island progressDone "$id" "${title#Running } failed" false "exit $rc · $took" >/dev/null 2>&1; fi
        exit $rc ;;
    *)
        sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
